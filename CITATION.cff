    given-names: Doula Isham Rashik

repository-code: "https://github.com/di37/prospective-claims"
license: CC-BY-4.0
type: dataset

keywords:
  - claim verification
  - prospective verification
  - earnings calls
  - forward-looking statements
  - XBRL
  - financial NLP
  - annotation guidelines
  - falsifiability
